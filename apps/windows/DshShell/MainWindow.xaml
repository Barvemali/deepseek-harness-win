<Window
    x:Class="DshShell.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid
            x:Name="Toolbar"
            Grid.Row="0"
            Padding="8,6"
            ColumnSpacing="4"
            Background="{ThemeResource LayerFillColorDefaultBrush}">
            <Grid.KeyboardAccelerators>
                <KeyboardAccelerator Key="F5" Invoked="OnReloadAccelerator" />
                <KeyboardAccelerator Key="R" Modifiers="Control,Shift" Invoked="OnRebuildViewAccelerator" />
            </Grid.KeyboardAccelerators>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" x:Name="BackButton" Click="OnBack" ToolTipService.ToolTip="Back">
                <FontIcon Glyph="&#xE72B;" FontSize="14" />
            </Button>
            <Button Grid.Column="1" x:Name="ForwardButton" Click="OnForward" ToolTipService.ToolTip="Forward">
                <FontIcon Glyph="&#xE72A;" FontSize="14" />
            </Button>
            <Button Grid.Column="2" x:Name="ReloadButton" Click="OnReload" ToolTipService.ToolTip="Reload (F5)">
                <FontIcon Glyph="&#xE72C;" FontSize="14" />
            </Button>
            <Button Grid.Column="3" x:Name="HomeButton" Click="OnHome" ToolTipService.ToolTip="Home">
                <FontIcon Glyph="&#xE80F;" FontSize="14" />
            </Button>
            <Button Grid.Column="4" x:Name="RestartServerButton" Click="OnRestartServer" ToolTipService.ToolTip="Restart dsh web server">
                <FontIcon Glyph="&#xE777;" FontSize="14" />
            </Button>
            <Button Grid.Column="5" x:Name="OpenBrowserButton" Click="OnOpenBrowser" ToolTipService.ToolTip="Open in browser">
                <FontIcon Glyph="&#xE8A7;" FontSize="14" />
            </Button>
            <Button Grid.Column="6" x:Name="SettingsButton" Click="OnSettings" ToolTipService.ToolTip="Server settings">
                <FontIcon Glyph="&#xE713;" FontSize="14" />
            </Button>
            <Button Grid.Column="7" x:Name="RebuildViewButton" Click="OnRebuildView" ToolTipService.ToolTip="Rebuild view (Ctrl+Shift+R)">
                <FontIcon Glyph="&#xE90F;" FontSize="14" />
            </Button>

            <StackPanel
                Grid.Column="8"
                Orientation="Horizontal"
                Spacing="10"
                VerticalAlignment="Center"
                Margin="8,0,4,0">
                <ProgressRing
                    x:Name="StatusRing"
                    Width="16"
                    Height="16"
                    IsActive="False"
                    Visibility="Collapsed" />
                <TextBlock
                    x:Name="StatusText"
                    VerticalAlignment="Center"
                    Text="DeepSeek Harness"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <StackPanel Grid.Column="9" Orientation="Horizontal" Spacing="4">
                <Button x:Name="RetryButton" Click="OnRetry" Content="Retry" Visibility="Collapsed" />
                <Button x:Name="OpenLogButton" Click="OnOpenLog" Content="Open log" Visibility="Collapsed" />
            </StackPanel>
        </Grid>

        <Grid x:Name="ViewHost" Grid.Row="1" />
    </Grid>
</Window>
